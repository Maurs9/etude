{
  "name": "piano-theory-trainer",
  "private": true,
  "description": "Étude — piano theory trainer (Vite-built static PWA).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs dist 8778",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "test:unit": "vitest run",
    "test:dev": "ETUDE_DEV_SERVER=1 playwright test --project=app",
    "test": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
