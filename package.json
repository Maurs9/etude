{
  "name": "piano-theory-trainer",
  "private": true,
  "description": "Étude — piano theory trainer (Vite-built static PWA).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs dist 8778",
    "typecheck": "node scripts/check-ts-suppressions.mjs && tsc --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "test:unit": "vitest run",
    "test:i18n": "node --test i18n/tests/i18n-extra.test.cjs",
    "test:dev": "playwright test --project=app",
    "test": "playwright test",
    "deps:check": "node scripts/update-deps.mjs --check",
    "update:deps": "node scripts/update-deps.mjs",
    "osmd:check": "node scripts/update-osmd.mjs --check",
    "update:osmd": "node scripts/update-osmd.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
